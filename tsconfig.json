{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "strict": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.mts",
    "skills/**/*.mts",
    "tests/**/*.js",
    "skills/**/*.mjs"
  ]
}
